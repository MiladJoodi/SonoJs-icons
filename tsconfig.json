{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@sonojs/icons": ["./src/index.ts"],
      "@sonojs/icons/icons": ["./src/named-icons.ts"]
    }
  },
  "include": ["src", "playground/src", "tests", "vite.config.ts", "vitest.config.ts", "tsup.config.ts"],
  "exclude": ["dist", "node_modules", "_svg_tmp"]
}
